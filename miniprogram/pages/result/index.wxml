<view class="page result">
  <view wx:if="{{loading}}" class="result__loading">
    <view class="result__loading-ball"></view>
    <text>正在挑选</text>
  </view>

  <block wx:else>
    <view class="result__summary">
      <view class="result__summary-head">
        <view class="result__summary-copy">
          <text class="result__title">{{result.summary}}</text>
          <text wx:if="{{result.pairingText}}" class="result__pairing-line">建议搭配“{{result.pairingText}}”</text>
        </view>
      </view>
    </view>

    <view class="result__sticky-actions">
      <button
        class="result__action result__action--mystery"
        open-type="share"
        data-share-type="mystery"
      >
        神秘礼物
      </button>
      <button
        class="result__action result__action--primary"
        loading="{{aiPicking}}"
        disabled="{{aiPicking}}"
        bindtap="aiPick"
      >{{aiPicking ? 'AI在想' : 'AI帮选'}}</button>
    </view>

    <view wx:if="{{aiPick}}" class="result__ai-card">
      <text class="result__ai-kicker">{{aiPick.headline}}</text>
      <text class="result__ai-name">{{aiPick.giftName}}</text>
      <text class="result__ai-reason">{{aiPick.reason}}</text>
      <text wx:if="{{aiPick.pairingText}}" class="result__ai-pairing">可以搭配“{{aiPick.pairingText}}”</text>
      <view wx:if="{{aiPick.tips.length}}" class="result__ai-tips">
        <text wx:for="{{aiPick.tips}}" wx:key="*this" class="result__ai-tip">{{item}}</text>
      </view>
    </view>

    <view class="result__goods-list">
      <view wx:for="{{result.candidates}}" wx:key="id" class="result__candidate-slot">
        <result-card item="{{item}}" />
      </view>
    </view>
  </block>
</view>
